# ComplyTrack configuration. Copy to .env (never commit it) for local work;
# on Render, set these in the service's Environment settings (render.yaml
# declares them). There are no host-specific fallbacks.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/complytrack
# At least 32 characters; also used to encrypt queued contractor tokens.
SESSION_SECRET=
PORT=8080
# Canonical public address of the app (no trailing slash). Used for email
# links, Stripe checkout/portal return URLs, the Stripe webhook and CORS.
# On Render it can stay unset until a custom domain exists (RENDER_EXTERNAL_URL
# is used instead).
PUBLIC_APP_URL=https://app.example.com

# --- Stripe (billing) -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional start-up bounds (milliseconds). /readyz reports "starting" until
# Stripe initialization finishes or STRIPE_INIT_TIMEOUT_MS passes (default
# 120000), then "ok" or "degraded" with a blocker while it keeps retrying.
# Without STRIPE_SECRET_KEY, /readyz is 503 in production and 200 with
# billing "unconfigured" elsewhere; checkout/add-ons stay disabled either way.
# STRIPE_INIT_TIMEOUT_MS=120000

# --- File storage (Google Cloud Storage) ------------------------------------
# Either paste a service-account key JSON on one line, or point
# GOOGLE_APPLICATION_CREDENTIALS at the key file. Without credentials, uploads
# report OBJECT_STORAGE_UNAVAILABLE.
GCS_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# Bucket paths, e.g. /my-bucket/private and /my-bucket/public. Production uses
# a bucket in europe-west3 (Frankfurt), next to the Render service and database;
# browser uploads PUT straight to the bucket, so its CORS must allow PUT from
# the site's origin with the Content-Type header.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
# Cancelled businesses' files move to this class 30 days after cancellation
# and back to STANDARD if they resubscribe: ARCHIVE (default), COLDLINE,
# NEARLINE, or off (e.g. when the bucket uses Autoclass).
# CANCELLED_FILES_STORAGE_CLASS=ARCHIVE

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_EMAIL=
FEEDBACK_RECIPIENT_EMAIL=

# --- Optional ---------------------------------------------------------------
ALLOWED_ORIGINS=
PASSKEY_RP_ID=
PASSKEY_ORIGIN=
# Error reporting: crashes and scheduled-job failures are sent to Sentry.
# One DSN covers the API and the website; the website reads it at build time.
# Environment tag: SENTRY_ENVIRONMENT, else NODE_ENV (API) / build mode (web).
# Release: SENTRY_RELEASE, else RENDER_GIT_COMMIT. Unset DSN = reports off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
LOG_LEVEL=info
# Dedicated key for contractor token encryption (defaults to SESSION_SECRET).
CONTRACTOR_TOKEN_ENCRYPTION_KEY=
CONTRACTOR_TOKEN_ENCRYPTION_KEY_VERSION=
CONTRACTOR_TOKEN_ENCRYPTION_PREVIOUS_KEYS=
DEMO_SEED_TOKEN=
# Platform operators by sign-in email (comma-separated, case-insensitive): may
# repair the Stripe price catalogue (/api/admin/*), issue ALPS discount codes
# and create businesses without a trial. Unset or empty means nobody.
PLATFORM_ADMIN_EMAILS=
# First-party analytics: bearer token (at least 32 characters, e.g.
# `openssl rand -hex 32`) for GET /api/internal/analytics/summary. Unset (or
# shorter) leaves that route disabled (404). Events are stored either way.
ANALYTICS_READ_TOKEN=

# Largest single file any upload may store, videos included (whole MB,
# 1-5120; default 250). Photos keep their own 10 MB limit.
# MAX_UPLOAD_MB=250
# Extra storage is sold at £1 per 10 GB a month. The app creates the Stripe
# price itself (10p per GB, monthly, GBP, service_key=storage) when Stripe is
# configured; STORAGE_ADDON_PRICE_ID names a different price instead.
# STORAGE_ADDON_PRICE_ID=
# Cost check: the provider's cost per GiB-month (USD; default 0.026, Google
# Cloud Storage Standard at its dearest European rate; set your bucket's rate)
# plus STORAGE_ALPS_MARKUP_PERCENT (default 20), converted at
# STORAGE_USD_EXCHANGE_RATE (pounds per 1 USD, e.g. 0.76; unset assumes 1,
# which overstates the cost) and rounded up to whole pence, must not exceed
# the 10p per GB price. If it does, new storage purchases pause and
# ADMIN_EMAIL is alerted. GET /api/admin/storage-price-check shows the sum.
# STORAGE_PROVIDER_USD_PER_GIB_MONTH=0.026
# STORAGE_ALPS_MARKUP_PERCENT=20
# STORAGE_USD_EXCHANGE_RATE=0.76
# Settings serves storage totals from a per-tenant ledger and rechecks them
# against the storage provider in the background once the last check is older
# than this many seconds (default 3600, minimum 60).
# STORAGE_USAGE_SNAPSHOT_MAX_AGE_SECONDS=3600

# --- AI (Claude) -------------------------------------------------------------
# Without a key no AI feature is offered. With one, AI needs the "AI features"
# add-on (£15 a month per business); the server creates that Stripe price
# itself (1500 GBP monthly, service_key=ai) when Stripe is configured, and
# AI_ADDON_PRICE_ID names a different price instead.
ANTHROPIC_API_KEY=
# AI_ADDON_PRICE_ID=
# AI use each business may have per paid month, in pence (default 1000 = £10),
# counted from the tokens Claude reports, at AI_USD_TO_GBP pounds per dollar
# (default 0.8). AI_TRIAL_ALLOWANCE_PENCE gives free trials some AI (default 0).
# AI_MONTHLY_ALLOWANCE_PENCE=1000
# AI_USD_TO_GBP=0.8
# AI_TRIAL_ALLOWANCE_PENCE=0
# Each AI feature's Claude model and effort (low, medium, high, xhigh, max).
# Defaults are in api-server src/lib/aiModels.ts: lists on claude-haiku-5-5
# (low), PAT registers and certificates on claude-sonnet-5-5 (low), audit
# reports on claude-opus-5-5 (medium). Set these only to change one.
# LIST_READING_MODEL= / LIST_READING_EFFORT=
# REGISTER_READING_MODEL= / REGISTER_READING_EFFORT=
# CERTIFICATE_READING_MODEL= / CERTIFICATE_READING_EFFORT=
# REPORT_READING_MODEL= / REPORT_READING_EFFORT=
# Top-ups, charged at once as a one-off invoice (no Stripe price needed): the
# price and the AI use each adds until renewal, in pence, and the most
# automatic top-ups an owner's "top up automatically" setting buys a month.
# AI_TOP_UP_PRICE_PENCE=600
# AI_TOP_UP_ALLOWANCE_PENCE=400
# AI_AUTO_TOP_UP_LIMIT=3

# --- Web build (compliance-tracker) -----------------------------------------
# Site URL for the generated sitemap/robots/SEO files.
PUBLIC_SITE_URL=
VITE_API_URL=

# --- Mobile build -----------------------------------------------------------
EXPO_PUBLIC_DOMAIN=
