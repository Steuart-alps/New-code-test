# ComplyTrack configuration. Copy to .env (never commit it) for local work;
# on Render, set these in the service's Environment settings (render.yaml
# declares them). There are no host-specific fallbacks.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/complytrack
# At least 32 characters; also used to encrypt queued contractor tokens.
SESSION_SECRET=
PORT=8080
# Canonical public address of the app (no trailing slash). Used for email
# links, Stripe checkout/portal return URLs, the Stripe webhook and CORS.
# On Render it can stay unset until a custom domain exists (RENDER_EXTERNAL_URL
# is used instead).
PUBLIC_APP_URL=https://app.example.com

# --- Stripe (billing) -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional start-up bounds (milliseconds). /readyz reports "starting" until
# Stripe initialization finishes or STRIPE_INIT_TIMEOUT_MS passes (default
# 120000), then "ok" or "degraded" with a blocker while it keeps retrying.
# Without STRIPE_SECRET_KEY, /readyz is 503 in production and 200 with
# billing "unconfigured" elsewhere; checkout/add-ons stay disabled either way.
# STRIPE_INIT_TIMEOUT_MS=120000

# --- File storage (Google Cloud Storage) ------------------------------------
# Either paste a service-account key JSON on one line, or point
# GOOGLE_APPLICATION_CREDENTIALS at the key file. Without credentials, uploads
# report OBJECT_STORAGE_UNAVAILABLE.
GCS_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# Bucket paths, e.g. /my-bucket/private and /my-bucket/public
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_EMAIL=
FEEDBACK_RECIPIENT_EMAIL=

# --- Optional ---------------------------------------------------------------
ALLOWED_ORIGINS=
PASSKEY_RP_ID=
PASSKEY_ORIGIN=
SENTRY_DSN=
LOG_LEVEL=info
# Dedicated key for contractor token encryption (defaults to SESSION_SECRET).
CONTRACTOR_TOKEN_ENCRYPTION_KEY=
CONTRACTOR_TOKEN_ENCRYPTION_KEY_VERSION=
CONTRACTOR_TOKEN_ENCRYPTION_PREVIOUS_KEYS=
DEMO_SEED_TOKEN=
# First-party analytics: bearer token (at least 32 characters, e.g.
# `openssl rand -hex 32`) for GET /api/internal/analytics/summary. Unset (or
# shorter) leaves that route disabled (404). Events are stored either way.
ANALYTICS_READ_TOKEN=

# Storage usage estimate shown in Settings: provider cost per GiB-month (USD;
# default 0.015) plus STORAGE_ALPS_MARKUP_PERCENT (default 20).
# STORAGE_PROVIDER_USD_PER_GIB_MONTH=0.015
# STORAGE_ALPS_MARKUP_PERCENT=20

# --- Web build (compliance-tracker) -----------------------------------------
# Site URL for the generated sitemap/robots/SEO files.
PUBLIC_SITE_URL=
VITE_API_URL=
VITE_SENTRY_DSN=

# --- Mobile build -----------------------------------------------------------
EXPO_PUBLIC_DOMAIN=
