{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:isolation": "node tests/tenant-isolation.mjs",
    "test:isolation:ci": "bash tests/run-tenant-isolation.sh",
    "test:trial-reminders": "node tests/trial-reminders.mjs",
    "test:modules": "node tests/module-routes.mjs",
    "test:modules:ci": "bash tests/run-module-routes.sh",
    "test:dept-isolation": "node tests/dept-isolation.mjs",
    "test:dept-isolation:ci": "bash tests/run-dept-isolation.sh",
    "test:dailytrack-locks": "node tests/dailytrack-locks.mjs",
    "test:dailytrack-locks:ci": "bash tests/run-dailytrack-locks.sh",
    "test:config": "node tests/config-endpoints.mjs",
    "test:config:ci": "bash tests/run-config-endpoints.sh",
    "test:training-expiry": "node tests/training-expiry-reminders.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "google-auth-library": "^10.6.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "otplib": "^13.4.1",
    "pino": "^9",
    "pino-http": "^10",
    "qrcode": "^1.5.4",
    "resend": "^6.10.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "express-session": "^1.19.0",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
