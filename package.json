{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --workspace-concurrency=1 --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "path-to-regexp": "8.4.0",
      "brace-expansion": "2.1.4",
      "@babel/core": "7.29.6",
      "@tootallnate/once": "2.0.1",
      "@xmldom/xmldom@0.8": "0.8.15",
      "@xmldom/xmldom@0.9": "0.9.12",
      "browserslist": "4.28.7",
      "body-parser": "2.3.0",
      "decode-uri-component": "0.5.0",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "tsx>esbuild": "0.28.1",
      "vite>esbuild": "0.28.1",
      "fast-uri": "3.1.6",
      "fast-xml-builder": "1.1.7",
      "fast-xml-parser": "5.7.0",
      "form-data@2": "2.5.6",
      "image-size": "npm:image-size-safe@2.0.3",
      "js-yaml": "4.3.1",
      "linkify-it": "5.0.2",
      "markdown-it": "14.2.0",
      "nanoid@3": "3.3.18",
      "nanoid@5": "5.1.16",
      "postcss": "8.5.23",
      "qs": "6.16.0",
      "uuid": "11.1.1",
      "yaml": "2.8.3",
      "ws": "8.21.0"
    },
    "patchedDependencies": {
      "image-size-safe@2.0.3": "patches/image-size-safe@2.0.3.patch"
    }
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "pdfjs-dist": "^6.3.289",
    "sharp": "^0.35.4",
    "stripe": "20.0.0",
    "stripe-replit-sync": "1.0.0"
  }
}
