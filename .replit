[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["glib", "gtk3", "gtk4", "pango", "cairo", "gdk-pixbuf", "harfbuzz", "vulkan-loader", "icu", "libxml2", "nspr", "sqlite", "libxslt", "lcms2", "libevent", "libopus", "flite", "libwebp", "libavif", "libjpeg", "libepoxy", "libsecret", "enchant", "hyphen", "xorg.libX11", "xorg.libxcb", "xorg.libXext", "xorg.libXrandr", "xorg.libXcomposite", "xorg.libXcursor", "xorg.libXdamage", "xorg.libXfixes", "xorg.libXi", "libxkbcommon", "wayland", "mesa", "atk", "at-spi2-atk", "gst_all_1.gstreamer", "gst_all_1.gst-plugins-base", "gst_all_1.gst-plugins-good", "gst_all_1.gst-plugins-bad", "gst_all_1.gst-plugins-ugly", "libdrm", "libgbm", "alsa-lib", "libvpx", "libmanette", "gst_all_1.gst-libav", "woff2", "libjpeg_turbo", "libglvnd", "icu74", "libgcc", "harfbuzzFull", "libjpeg8", "libGL", "libGLX"]

[userenv]

[userenv.shared]
FEEDBACK_RECIPIENT_EMAIL = "Info@alpsconsultancy.co.uk"
CONTRACTOR_TOKEN_ENCRYPTION_KEY_VERSION = "2026-09-01"
GCS_PROJECT_ID = "project-ea358f54-678e-42e7-814"
GCS_BUCKET_NAME = "alpscomplytrack"
TWILIO_VERIFY_SERVICE_SID = "VAa8456cf2efe3b6e6acf2d5a61c447820"

[userenv.production]
PUBLIC_APP_URL = "https://complytrack.alpsconsultancy.co.uk"
ADMIN_EMAIL = "info@alpsconsultancy.co.uk"
