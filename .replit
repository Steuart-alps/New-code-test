modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "trial-reminders"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-trial-reminders"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-tenant-isolation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "module-routes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow]]
name = "trial-reminders"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:trial-reminders"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "test-trial-reminders"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:trial-reminders"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-tenant-isolation"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:isolation:ci"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "module-routes"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:modules:ci"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck && pnpm --filter @workspace/compliance-tracker run typecheck && pnpm --filter @workspace/mobile run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
